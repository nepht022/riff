<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Saber se o Spotify está instalado (Android 11+ esconde os outros apps sem isto). -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>
    <application>
        <!-- "Acesso às notificações": só para ler a sessão de mídia do Spotify; nenhuma notificação é lida. -->
        <service
            android:name="com.rodrigomachado.riff.core.spotify.session.RiffNotificationListener"
            android:exported="false"
            android:label="Riff"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
