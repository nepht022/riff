{
  "rules": {
    // Nada fora de salas/ é legível ou gravável.
    ".read": false,
    ".write": false,
    "salas": {
      // Ninguém lista salas: o código é o segredo da sala. (Uma listagem só das salas mortas dependeria de
      // comparar query.endAt com now, e o emulador recusa qualquer < ou <= sobre query.endAt; ver firebase/README.md.)
      "$codigo": {
        ".read": "auth != null",
        // O .write deste nível vale para a sala inteira (em cascata), então só cobre os dois casos de sala inteira:
        // criar (não existe; quem cria é o dono e jogador; tempos do servidor; as vagas garantem que ele é o único
        // jogador) e apagar (o dono, ou qualquer autenticado se a sala está morta há mais de 2 h).
        // Qualquer outra escrita cai nas regras dos filhos.
        ".write": "auth != null && ((!data.exists() && newData.child('dono').val() == auth.uid && newData.child('estado').val() == 'sala' && newData.child('criadaEm').val() == now && newData.child('atividadeEm').val() == now && newData.child('jogadores').child(auth.uid).exists()) || (data.exists() && !newData.exists() && (data.child('dono').val() == auth.uid || data.child('atividadeEm').val() < now - 7200000)))",
        // Código: 4 letras de ABCDEFGHJKMNPQRSTUVWXYZ (sem I, L, O; sem números).
        ".validate": "$codigo.matches(/^[A-HJKMNP-Z]{4}$/) && newData.hasChildren(['dono', 'estado', 'criadaEm', 'atividadeEm'])",
        "dono": {
          // O dono passa adiante quando quiser; um jogador da sala assume se o dono sumiu (vistoEm há mais de 60 s)
          // ou não está mais entre os jogadores.
          ".write": "auth != null && data.exists() && newData.exists() && (data.val() == auth.uid || (data.parent().child('jogadores').child(auth.uid).exists() && (!data.parent().child('jogadores').child(data.val()).exists() || now - data.parent().child('jogadores').child(data.val()).child('vistoEm').val() > 60000)))",
          // O novo dono é um jogador da sala (depois da escrita).
          ".validate": "newData.isString() && newData.parent().child('jogadores').child(newData.val()).exists()"
        },
        "estado": {
          ".write": "auth != null && newData.exists() && data.parent().child('dono').val() == auth.uid",
          // Transições da rodada (o newData da sala inteira vale, então um PATCH da sala é conferido junto):
          // - entrar em "contagem" (vindo de outro estado) só subindo a rodada na mesma escrita (ver "rodada");
          // - "partida" só depois da "contagem" (ou repetindo a "partida") e sempre com o inicio;
          // - "sala" e "contagem" sem inicio (voltar à sala e começar uma rodada apagam o inicio).
          ".validate": "newData.isString() && newData.val().matches(/^(sala|contagem|partida|fim)$/) && (newData.val() != 'contagem' || data.val() == 'contagem' || newData.parent().child('rodada').val() != data.parent().child('rodada').val()) && (newData.val() != 'partida' || ((data.val() == 'contagem' || data.val() == 'partida') && newData.parent().child('inicio').exists())) && ((newData.val() != 'sala' && newData.val() != 'contagem') || !newData.parent().child('inicio').exists())"
        },
        // Rodada: só o dono, só sobe de 1 em 1 (sem rodada antes = 0, então a primeira é 1) e só junto com a
        // "contagem" (o Começar grava estado e rodada na mesma escrita). Nunca é apagada (só com a sala inteira).
        "rodada": {
          ".write": "auth != null && newData.exists() && data.parent().child('dono').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.parent().child('estado').val() == 'contagem' && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
        },
        // Início da música na rodada (hora do servidor): só o dono, só na "partida", entre agora e 20 s depois.
        // Apagar só saindo da partida na mesma escrita (o .validate não roda em deleção, então a conferência é aqui).
        "inicio": {
          ".write": "auth != null && data.parent().child('dono').val() == auth.uid && (newData.exists() || newData.parent().child('estado').val() != 'partida')",
          ".validate": "newData.isNumber() && now <= newData.val() && newData.val() <= now + 20000 && newData.parent().child('estado').val() == 'partida'"
        },
        // Música escolhida: só o dono, só com a sala no estado "sala"; sem musica = nenhuma escolhida.
        "musica": {
          ".write": "auth != null && data.parent().child('dono').val() == auth.uid",
          ".validate": "newData.hasChildren(['chartId', 'titulo', 'artista', 'dificuldades']) && newData.parent().child('estado').val() == 'sala'",
          // SHA-1 do arquivo de notas, em hexadecimal minúsculo (o id do mapa no app).
          "chartId": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{40}$/)"
          },
          "titulo": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "artista": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          // As dificuldades do mapa, separadas por vírgula, sem espaços: "EASY,MEDIUM,HARD,EXPERT".
          "dificuldades": {
            ".validate": "newData.isString() && newData.val().matches(/^(EASY|MEDIUM|HARD|EXPERT)(,(EASY|MEDIUM|HARD|EXPERT))*$/)"
          },
          "duracaoMs": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          // Só nas músicas que vieram do Encore: o md5 do pacote, se tem vídeo de fundo e quem fez o mapa.
          "encore": {
            ".validate": "newData.hasChildren(['md5', 'video'])",
            "md5": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-fA-F]{32}$/)"
            },
            "video": {
              ".validate": "newData.isBoolean()"
            },
            "charter": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$outro": {
              ".validate": false
            }
          },
          "$outro": {
            ".validate": false
          }
        },
        "criadaEm": {
          ".write": "auth != null && newData.exists() && data.parent().child('dono').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "atividadeEm": {
          // Qualquer jogador da sala (inclusive quem entra na mesma escrita), sempre com o tempo do servidor.
          ".write": "auth != null && newData.exists() && newData.parent().child('jogadores').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        // Vagas: as regras do Realtime Database não contam filhos, então o limite de 4 jogadores vem de 4 vagas
        // (v1 a v4). Cada jogador ocupa uma vaga com o próprio uid e aponta para ela em jogadores/{uid}/vaga; um
        // jogador sem a vaga dele é recusado, e uma vaga só guarda um uid, então nunca há mais de 4.
        "vagas": {
          "$vaga": {
            // Ocupar: vaga livre, já sua, ou abandonada (o uid que está nela não aponta mais para ela).
            // Liberar: só uma vaga cujo jogador não aponta mais para ela (sai da sala na mesma escrita, por exemplo).
            ".write": "auth != null && data.parent().parent().child('dono').exists() && (!data.exists() || data.val() == auth.uid || newData.parent().parent().child('jogadores').child(data.val()).child('vaga').val() != $vaga) && (newData.exists() || newData.parent().parent().child('jogadores').child(data.val()).child('vaga').val() != $vaga)",
            ".validate": "$vaga.matches(/^v[1-4]$/) && newData.val() == auth.uid && newData.parent().parent().child('jogadores').child(auth.uid).child('vaga').val() == $vaga"
          }
        },
        "jogadores": {
          "$uid": {
            // Cada um escreve só a si mesmo, numa sala que existe; o dono pode remover qualquer jogador.
            ".write": "auth != null && ((auth.uid == $uid && data.parent().parent().child('dono').exists()) || (data.exists() && !newData.exists() && data.parent().parent().child('dono').val() == auth.uid))",
            // Entrar exige ocupar a vaga indicada na mesma escrita (ver "vagas").
            ".validate": "newData.hasChildren(['nome', 'aparelho', 'vaga', 'entrouEm', 'vistoEm']) && newData.parent().parent().child('vagas').child(newData.child('vaga').val()).val() == $uid",
            "nome": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "aparelho": {
              ".validate": "newData.isString() && newData.val().matches(/^(celular|pc)$/)"
            },
            "vaga": {
              ".validate": "newData.isString() && newData.val().matches(/^v[1-4]$/)"
            },
            // Tempos do servidor; regravar o mesmo valor (entrar de novo mantendo o entrouEm) também vale.
            "entrouEm": {
              ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
            },
            "vistoEm": {
              ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
            },
            // Estado do jogador para a música da sala (o próprio jogador grava; ver o .write do jogador).
            "dificuldade": {
              ".validate": "newData.isString() && newData.val().matches(/^(EASY|MEDIUM|HARD|EXPERT)$/)"
            },
            "pronto": {
              ".validate": "newData.isBoolean()"
            },
            "musica": {
              ".validate": "newData.isString() && newData.val().matches(/^(tem|baixando|sem)$/)"
            },
            // A rodada em que a música dele carregou / que ele abandonou: sempre a rodada atual da sala (depois da
            // escrita); sem rodada na sala, nenhuma.
            "carregou": {
              ".validate": "newData.isNumber() && newData.val() == newData.parent().parent().parent().child('rodada').val()"
            },
            "saiu": {
              ".validate": "newData.isNumber() && newData.val() == newData.parent().parent().parent().child('rodada').val()"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        // Placar da rodada (M3): placar/{rodada}/{uid}, gravado pelo próprio jogador a cada 1 s e no fim (terminou).
        // O $rodada do caminho é texto e a rodada da sala é número: a comparação converte a rodada em texto
        // (rodada + ''), então "03", "+3" ou "x" nunca batem ("." nem cabe numa chave).
        "placar": {
          "$rodada": {
            // Só o dono, só apagando a rodada inteira, e só uma rodada antiga: nem a atual nem a anterior (o
            // Resultado da sala de quem atrasou), pela rodada da sala depois da escrita (o Começar da rodada n apaga
            // placar/{n - 2} no mesmo PATCH). O .validate não roda em deleção, então a conferência é toda aqui.
            ".write": "auth != null && !newData.exists() && data.parent().parent().child('dono').val() == auth.uid && newData.parent().parent().child('rodada').isNumber() && $rodada != newData.parent().parent().child('rodada').val() + '' && $rodada != (newData.parent().parent().child('rodada').val() - 1) + ''",
            "$uid": {
              // Só o próprio uid, jogador da sala (depois da escrita), na rodada atual ou na anterior (o envio final
              // que chegou depois de o dono começar a seguinte); a rodada 0 não existe. Ninguém apaga um placar
              // (nem o próprio): só o dono, a rodada antiga inteira (acima), ou a sala inteira.
              ".write": "auth != null && auth.uid == $uid && newData.exists() && newData.parent().parent().parent().child('jogadores').child($uid).exists() && newData.parent().parent().parent().child('rodada').isNumber() && $rodada != '0' && ($rodada == newData.parent().parent().parent().child('rodada').val() + '' || $rodada == (newData.parent().parent().parent().child('rodada').val() - 1) + '')",
              ".validate": "newData.hasChildren(['pontos', 'combo', 'maiorCombo', 'acertos', 'notas', 'precisao', 'terminou', 'atualizadoEm'])",
              // Inteiros >= 0 com teto; precisao em centésimos de ponto percentual (0 a 10000 = 0% a 100%).
              "pontos": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "combo": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "maiorCombo": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "acertos": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "notas": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "precisao": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 10000"
              },
              "terminou": {
                ".validate": "newData.isBoolean()"
              },
              // Hora do servidor da escrita: quem lê vê há quanto tempo o jogador não manda o placar ("sem conexão").
              "atualizadoEm": {
                ".validate": "newData.isNumber() && newData.val() == now"
              },
              "$outro": {
                ".validate": false
              }
            }
          }
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
